# Environment Configuration
DATABASE_URL=sqlite:///./recruitment.db
UPLOAD_DIR=./uploads
SECRET_KEY=dev-recruitment-secret-key-replace-in-production

# LLM Providers (Optional - System uses deterministic rule/heuristic engine when omitted)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Calendar Integration (Optional - System operates in high-fidelity mock mode when empty)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
CALENDAR_TIMEZONE=UTC

# Email Integration (Optional - System operates in rich mock mode when empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=careers@company.com
